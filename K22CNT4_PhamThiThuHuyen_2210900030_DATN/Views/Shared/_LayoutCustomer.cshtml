<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    <meta charset="utf-8">

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600&family=Raleway:wght@600;800&display=swap" rel="stylesheet">

    <!-- Icons -->
    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.15.4/css/all.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Libraries -->
    <link href="~/lib/lightbox/css/lightbox.min.css" rel="stylesheet">
    <link href="~/lib/owlcarousel/assets/owl.carousel.min.css" rel="stylesheet">

    <!-- Bootstrap -->
    <link href="~/css/bootstrap.min.css" rel="stylesheet">

    <!-- CSS -->
    <link href="~/css/style.css" rel="stylesheet">
    <link href="~/css/home.css" rel="stylesheet">
    <link href="~/css/product-detail.css" rel="stylesheet" />

    <style>
        .cart-icon {
            width: 42px;
            height: 42px;
            font-size: 20px;
            color: #333;
        }

        .cart-badge {
            position: absolute;
            top: -6px;
            right: -6px;
            min-width: 18px;
            height: 18px;
            padding: 0 5px;
            font-size: 11px;
            line-height: 18px;
            border-radius: 50%;
            background: #dc3545;
            color: white;
            text-align: center;
        }
    </style>
</head>

<body>
    <div>

        <!-- NAVBAR -->
        <div class="container-fluid fixed-top">

            <!-- TOP BAR -->
            <div class="container topbar bg-primary d-none d-lg-block">
                <div class="d-flex justify-content-between">
                    <div class="top-info ps-2">
                        <small class="me-3">
                            <i class="fas fa-map-marker-alt me-2 text-secondary"></i>
                            <a href="#" class="text-white">123 Nguyễn Trãi, Việt Nam</a>
                        </small>
                        <small class="me-3">
                            <i class="fas fa-envelope me-2 text-secondary"></i>
                            <a href="#" class="text-white">huyenphamthithu@Example.com</a>
                        </small>
                    </div>
                </div>
            </div>

            <div class="container px-0">
                <nav class="navbar navbar-light bg-white navbar-expand-xl">

                    <!-- LOGO -->
                    <a asp-controller="Home" asp-action="Index" class="navbar-brand">
                        <img src="https://theme.hstatic.net/200000770807/1001123544/14/logo.png?v=353"
                             alt="Logo" width="180" height="80" />
                    </a>

                    <button class="navbar-toggler py-2 px-3"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#navbarCollapse">
                        <span class="fa fa-bars text-primary"></span>
                    </button>

                    <div class="collapse navbar-collapse bg-white" id="navbarCollapse">

                        <!-- MENU -->
                        <div class="navbar-nav mx-auto">
                            <a asp-controller="Home" asp-action="Index" class="nav-item nav-link">Trang chủ</a>
                            <a asp-controller="Product" asp-action="Girls" class="nav-item nav-link">Thời trang bé gái</a>
                            <a asp-controller="Product" asp-action="Boys" class="nav-item nav-link">Thời trang bé trai</a>
                            <a asp-controller="Order" asp-action="MyOrders" class="nav-item nav-link">Đơn hàng của tôi</a>
                            <a asp-controller="Contact" asp-action="Index" class="nav-item nav-link">Liên hệ</a>

                            <!-- USER -->
                            @{
                                var username = Context.Session.GetString("USERNAME");
                            }
                            @if (!string.IsNullOrEmpty(username))
                            {
                                <div class="nav-item dropdown">
                                    <a href="#" class="nav-link dropdown-toggle d-flex align-items-center"
                                       data-bs-toggle="dropdown">
                                        <img src="~/uploads/avatars/default-avatar.png"
                                             class="rounded-circle me-2"
                                             width="27" height="27"
                                             style="object-fit:cover" />

                                    </a>

                                    <div class="dropdown-menu dropdown-menu-end">
                                        <span class="dropdown-item-text fw-bold">
                                            👋 @username
                                        </span>

                                        <div class="dropdown-divider"></div>

                                        <a asp-controller="Profile" asp-action="Index"
                                           class="dropdown-item">
                                            👤 Trang cá nhân
                                        </a>

                                        <div class="dropdown-divider"></div>

                                        <a asp-controller="Account" asp-action="Logout"
                                           class="dropdown-item text-danger">
                                            🚪 Đăng xuất
                                        </a>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="nav-item dropdown">
                                    <a href="#" class="nav-link dropdown-toggle"
                                       data-bs-toggle="dropdown">
                                        <i class="fas fa-user fs-4"></i>
                                    </a>

                                    <div class="dropdown-menu dropdown-menu-end">
                                        <a asp-controller="Account" asp-action="Login"
                                           class="dropdown-item">Đăng nhập</a>
                                        <a asp-controller="Account" asp-action="Register"
                                           class="dropdown-item">Đăng ký</a>
                                    </div>
                                </div>
                            }

                        <!-- END MENU -->
                        <!-- RIGHT ICONS -->
                        <div class="d-flex m-3 me-0">

                            <!-- SEARCH -->
                            <form asp-controller="Product" asp-action="Search"
                                  method="get" class="d-flex align-items-center me-3">
                                <input type="text" name="keyword"
                                       class="form-control form-control-sm me-2"
                                       placeholder="Tìm sản phẩm..." style="width:180px" />
                                <button type="submit"
                                        class="btn-search btn border border-secondary btn-md-square rounded-circle bg-white">
                                    <i class="fas fa-search text-primary"></i>
                                </button>
                            </form>

                            <!-- CART -->
                            @{
                                var cartCount = Context.Session.GetInt32("CART_COUNT") ?? 0;
                            }

                            <a href="/Cart" class="cart-icon position-relative">
                                <i class="fas fa-shopping-cart"></i>
                                <span class="cart-badge @(cartCount == 0 ? "d-none" : "")">
                                    @cartCount
                                </span>
                            </a>
                        </div>

                    </div>
                </nav>
            </div>
        </div>

        <!-- BODY -->
        <div style="min-height:400px; margin-top:150px">
            @RenderBody()
        </div>

        @await Html.PartialAsync("_Footer")
    </div>

    <!-- JS -->
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.4/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/main.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
